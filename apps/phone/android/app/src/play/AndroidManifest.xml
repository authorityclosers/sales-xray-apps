<?xml version="1.0" encoding="utf-8"?>
<!--
  The Google Play build (the "play" flavour). Removed, because Play allows them only for other kinds of app:
  - call history (READ_CALL_LOG: Play's SMS and Call Log policy): no work-call logging from the phone's
    dialer; a call placed from the app is answered by the seller ("How did it go?");
  - placing calls directly (CALL_PHONE): the app opens the dialer with the number in;
  - all-files access (Play's All files access policy): the dialer's recordings are read as audio
    (READ_MEDIA_AUDIO), and through a folder the seller picks where the phone hides them;
  - the accessibility call recorder (Play bans accessibility for call recording);
  - asking to skip battery optimisation: the setup screen opens Android's battery list instead;
  - in-app recording of a conversation, for now (owner, 24 Oct 2026: "Get clearance faster record the
    audipo can be added in next version after that"): no AppRecorder and no microphone foreground
    service. The code stays; deleting those lines turns it back on.
  The microphone itself (RECORD_AUDIO) is kept from 1.0.35 (owner, 26 Oct 2026), for voice notes in
  Report a problem: asked when the seller taps record, only for our own pages, stopped when the app goes
  to the background, never in a service and never on a call (WebMic, MicRules).
  Backup is off (23 Oct 2026): Android's cloud backup would copy the sign-in, the phone's id and
  conversations recorded in the app (meeting audio) to the seller's Google Drive. A new phone signs
  in again. Android 12+ still moves the app's data in a phone-to-phone transfer the seller starts.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.READ_CALL_LOG" tools:node="remove" />
    <uses-permission android:name="android.permission.CALL_PHONE" tools:node="remove" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove" />
    <!-- Nothing in the Play build runs in the foreground (no recorder), so not even the general permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <application
        android:allowBackup="false"
        tools:replace="android:allowBackup">
        <service
            android:name="com.authorityclosers.salesxray.CallRecorderService"
            tools:node="remove" />
        <service
            android:name="com.authorityclosers.salesxray.AppRecorder"
            tools:node="remove" />
    </application>
</manifest>
