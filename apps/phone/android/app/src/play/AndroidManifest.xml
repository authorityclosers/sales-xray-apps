<?xml version="1.0" encoding="utf-8"?>
<!-- Play Store builds (-PsxPlay): no accessibility call recorder (Play bans it for call recording). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <service
            android:name="com.authorityclosers.salesxray.CallRecorderService"
            tools:node="remove" />
    </application>
</manifest>
