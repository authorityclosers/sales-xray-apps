<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press shortcut "Calls" before Android 8: the glyph on a round paper background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/sx_paper" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_shortcut_calls_glyph" android:gravity="fill" />
</layer-list>
