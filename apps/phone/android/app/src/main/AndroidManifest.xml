<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Nothing of this app goes to a backup or a new phone (owner, 24 Oct 2026:
         "Log work calls" turned itself on). Its settings belong to this phone:
         a restored copy turns "Logging work calls" back on with no tap, with
         another phone's SIM and device id. Android 12+ still moves data phone
         to phone unless the rules say not. -->
    <application
        android:name=".SalesXrayApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup,android:fullBackupContent,android:dataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="${appLabel}"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google sign-in (GoogleSignIn.java) and Connect (ConnectFlow.java) come back here from the browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" />
            </intent-filter>

        </activity>

        <!-- Facebook sign-in inside the app (NativeSignIn.java). The SDK starts with the app ID
             Sales X-Ray's server sends for its environment; it logs no app events and collects no
             advertising ID. Without the Facebook app installed, Facebook's sheet returns here
             (fb + app ID: production and the dev test app). -->
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="false" />
        <activity
            android:name="com.facebook.CustomTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fb1448624290545887" />
                <data android:scheme="fb1514054053884522" />
            </intent-filter>
        </activity>

        <!-- Lead alerts from Sales Xray (Firebase Cloud Messaging; LeadAlerts.java). -->
        <service
            android:name=".LeadAlertService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- In-app recording of a conversation (AppRecorder.java): microphone only, never during a phone call. -->
        <service
            android:name=".AppRecorder"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Optional call recorder (CEO 19 Oct): off until the seller switches it on in the app and
             in Accessibility settings. Direct-install builds only: the play flavour removes it. -->
        <service
            android:name=".CallRecorderService"
            android:exported="true"
            android:label="Sales Xray call recorder"
            android:foregroundServiceType="microphone"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/call_recorder_service" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- No advertising ID, whatever a library adds (the Facebook SDK would add it): Sales X-Ray shows no
         ads, and Play Console says "No advertising ID" (23 Oct 2026). CI checks both merged manifests. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <!-- Nor Android's Privacy Sandbox ad permissions the Facebook SDK adds: Facebook Login doesn't use them
         (1.0.24's bundle carried them; Play Console says "No advertising ID"). -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_CUSTOM_AUDIENCE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Calls on this phone: list and read the phone's own call recordings. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Only for phones that hide the call folder from the media index (test builds; not for Play). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <!-- Calling a lead from the app: place the call, see when it ends and read its talk time. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Download builds only: Play allows call history just for default phone apps. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- Phone setup (download builds): ask to keep Sales Xray running in the background, so call logging and alerts arrive. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- "Tell me about new recordings", and lead alerts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The urgent haptic token's three pulses (Haptics); touch feedback needs no permission. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- In-app recording (AppRecorder): the microphone, in a foreground service with a Stop button. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Capacitor's WebView client grants the page's microphone (voice notes in Report a problem)
         only when RECORD_AUDIO and MODIFY_AUDIO_SETTINGS are both granted. A normal permission:
         Android grants it at install, with no prompt. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- The installed dialers, to say which one saves recordings where (RecorderProfile). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <!-- Connect opens Facebook's and Google's sign-in in a browser, never another app (ConnectFlow.java). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Truecaller's after-call screen covers "How did it go?": Phone setup says how to stop it (PhoneSetup). -->
        <package android:name="com.truecaller" />
        <!-- Facebook sign-in switches to the Facebook app when it is installed (NativeSignIn). -->
        <package android:name="com.facebook.katana" />
    </queries>
</manifest>
