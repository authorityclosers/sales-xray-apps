<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".SalesXrayApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="${appLabel}"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google sign-in (GoogleSignIn.java) and Connect (ConnectFlow.java) come back here from the browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" />
            </intent-filter>

        </activity>

        <!-- Lead alerts from Sales Xray (Firebase Cloud Messaging; LeadAlerts.java). -->
        <service
            android:name=".LeadAlertService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- In-app recording of a conversation (AppRecorder.java): microphone only, never during a phone call. -->
        <service
            android:name=".AppRecorder"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Optional call recorder (CEO 19 Oct): off until the seller switches it on in the app and
             in Accessibility settings. Direct-install builds only: the play flavour removes it. -->
        <service
            android:name=".CallRecorderService"
            android:exported="true"
            android:label="Sales Xray call recorder"
            android:foregroundServiceType="microphone"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/call_recorder_service" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- No advertising ID, whatever a library adds (Play Console: "No advertising ID", 23 Oct 2026). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <!-- Calls on this phone: list and read the phone's own call recordings. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Only for phones that hide the call folder from the media index (test builds; not for Play). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <!-- Calling a lead from the app: place the call, see when it ends and read its talk time. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Download builds only: Play allows call history just for default phone apps. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- Phone setup (download builds): ask to keep Sales Xray running in the background, so call logging and alerts arrive. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- "Tell me about new recordings", and lead alerts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- In-app recording (AppRecorder): the microphone, in a foreground service with a Stop button. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- The installed dialers, to say which one saves recordings where (RecorderProfile). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <!-- Connect opens Facebook's and Google's sign-in in a browser, never another app (ConnectFlow.java). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Truecaller's after-call screen covers "How did it go?": Phone setup says how to stop it (PhoneSetup). -->
        <package android:name="com.truecaller" />
    </queries>
</manifest>
