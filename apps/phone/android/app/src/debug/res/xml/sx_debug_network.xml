<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the live web update test (scripts/emulator-live-web.sh) serves its signed manifest and
     bundles from the emulator's host machine over plain http. Everything else keeps Android's default (https). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
